# Spectrum Cloud iMessage line (https://app.photon.codes). Leave blank to use this Mac's Messages.app.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Your name as the group knows you; your own messages in scanned history use it.
OWNER_NAME=

# Bot messages use regular iMessage text (off), with only headlines in bold. To set
# every message in a Unicode font instead: bold (𝗯𝗼𝗹𝗱), smallcaps (ꜱᴍᴀʟʟ ᴄᴀᴘꜱ),
# double (𝕕𝕠𝕦𝕓𝕝𝕖), mono (𝚖𝚘𝚗𝚘) or sans (𝗌𝖺𝗇𝗌).
BOT_FONT=off

# Opening odds: the bot's guess counts as this many dollars already in the pot,
# so early bets nudge the odds instead of swinging them to 0% or 100%.
PRIOR_WEIGHT=20
# Re-post a market's chart this long after the last bet in a burst.
LIVE_CHART_DELAY_MS=15000
# Post an update when a mirrored Kalshi market moves this many points.
KALSHI_MOVE_POINTS=5

# Claude sets opening odds from scanned chat history (npm run scan), picks
# matching Kalshi markets, and spots bettable claims in normal chat.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 (most accurate, ~6¢/market). claude-sonnet-5-5 is half price; claude-haiku-4-5 is cheapest.
ANTHROPIC_MODEL=
# What markets read about the group: digest (default) is the dossier `npm run scan`
# writes, ~11K tokens and ~2¢ a market. full sends the raw history (~115K tokens).
CONTEXT_MODE=digest
# Personality profiles are cached per person and rebuilt after this many new messages.
PROFILE_REFRESH=100
BET_DETECTION=on
DETECT_COOLDOWN_MS=45000

DB_PATH=markets.db

# play (default): 1,000-coin wallets, nothing is ever owed. Use this for demos.
# real: bets are dollars, the bot tracks IOUs and sends payment reminders.
MONEY_MODE=play
# A bare "!yes" or "!no" bets this much on the newest market (coins in play mode).
DEFAULT_BET=
# Close times: last-call warning this many minutes before, then a reminder to
# the creator every N hours until they resolve.
LAST_CALL_MINUTES=15
RESOLVE_REMIND_HOURS=12
# !demo mirrors a Kalshi crypto market that settles within the hour. Demo only.
DEMO=off

# Real-money settings. The bot never touches money; it tracks IOUs and nags.
# MAX_BET is dollars per person per market. First reminder NAG_FIRST_HOURS after
# settling; after NAG_PUBLIC_AFTER private reminders it also calls the debtor out
# in the group (once a day, NAG_PUBLIC=off to disable). No reminders between
# QUIET_START and QUIET_END (24h clock, local time).
MAX_BET=50
NAG_FIRST_HOURS=3
NAG_PUBLIC=on
NAG_PUBLIC_AFTER=2
QUIET_START=22
QUIET_END=9

RESOLVE_INTERVAL_MS=60000

# Restrict the bot to these chat ids (find them with `npm run discover`).
ALLOWED_CHATS=

# WEB=on serves a live web page per market (plus a Cloudflare tunnel for a public URL).
# Off by default: chat replies no longer link to it.
WEB=
