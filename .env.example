# Spectrum Cloud iMessage line (https://app.photon.codes). Leave blank to use this Mac's Messages.app.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Optional: Claude spots bettable claims in normal chat and suggests markets.
ANTHROPIC_API_KEY=
BET_DETECTION=on
DETECT_COOLDOWN_MS=45000

DB_PATH=markets.db
RESOLVE_INTERVAL_MS=60000

# Restrict the bot to these chat ids (find them with `npm run discover`).
ALLOWED_CHATS=
